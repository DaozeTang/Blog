<footer class="footer" id="site-footer">
    <div class="shell">
        <div class="footer__edge">end of line</div>
        <div class="footer__hud panel">
            <div class="footer__leds" aria-hidden="true">
                <span class="led led--blink"></span>
                <span class="led led--gold"></span>
                <span class="led led--coral"></span>
            </div>
            <div class="footer__note">{{ site.footer_text }}</div>
            <div class="footer__meta">
                <span>&copy; {{ site.start_year }}–{{ "now" | date: "%Y" }} {{ site.author.name }}</span>
                <span class="footer__sep">&#9670;</span>
                <a href="/rss.xml">RSS</a>
                <a href="/sitemap.xml">Sitemap</a>
                <a href="/archive/">Archive</a>
                <span class="footer__sep">&#9670;</span>
                <span>16-bit &middot; no cookies</span>
            </div>
        </div>
    </div>
</footer>
