<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
    {% include "head" %}
</head>
<body>
    {% include "sprite" %}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.analytics.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <div class="stage" aria-hidden="true">
        <div class="stage__beam"></div>
        <div class="stage__dots"></div>
        <div class="stage__scan"></div>
    </div>

    {% include "masthead" %}

    <main class="main" id="main-content" tabindex="-1">
        <div class="shell">
            {{ content }}
        </div>
    </main>

    {% include "footer" %}

    <button class="totop" type="button" id="back-to-top" aria-label="Back to top">
        <svg class="ico" aria-hidden="true"><use href="#i-arrow-up"></use></svg>
    </button>

    <script src="/scripts/site.js" defer></script>
    {% if showScene %}<script src="/scripts/pixel-scene.js" defer></script>{% endif %}
</body>
</html>
