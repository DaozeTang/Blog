<!DOCTYPE html>
<html lang="{{ site.lang }}">

<head>
    {% include "head" %}
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.analytics.gtm_body_id }}"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <div class="canvas-grid" aria-hidden="true"></div>
    <div class="canvas-scanlines" aria-hidden="true"></div>
    <div class="canvas-vignette" aria-hidden="true"></div>

    {% include "navbar" %}

    <main class="page-main" id="main-content" tabindex="-1">
        <div class="shell">
            {{ content }}
        </div>
    </main>

    {% include "footer" %}

    <script src="/scripts/site.js" defer></script>
</body>
</html>
