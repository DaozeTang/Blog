---
layout: base.liquid
ogType: article
---
<article class="post" data-pagefind-body>
    <div class="progress" id="reading-progress" aria-hidden="true">
        {% for i in (1..32) %}<span class="progress__seg"></span>{% endfor %}
    </div>

    <header class="post-head">
        {% if category and category != "" %}
        <a class="chip chip--accent post-head__cat" href="/categories/{{ category | ghSlug }}/">
            <svg class="ico" aria-hidden="true"><use href="#i-folder"></use></svg>{{ category }}
        </a>
        {% endif %}

        <h1 class="post-title">{{ title }}</h1>

        <ul class="post-meta" data-pagefind-ignore>
            <li><svg class="ico" aria-hidden="true"><use href="#i-calendar"></use></svg><time datetime="{{ published | isoDate }}">{{ published | readableDate }}</time></li>
            {% if updated %}
            <li><svg class="ico" aria-hidden="true"><use href="#i-sort"></use></svg>Updated {{ updated | readableDate }}</li>
            {% endif %}
            <li><svg class="ico" aria-hidden="true"><use href="#i-clock"></use></svg>{{ content | readingTime }}</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-file"></use></svg>{{ content | wordCount }} chars</li>
            {% if pinned %}
            <li><svg class="ico" aria-hidden="true"><use href="#i-pin"></use></svg>Pinned</li>
            {% endif %}
        </ul>

        {% if tags.size > 0 %}
        <div class="post-tags chips" data-pagefind-ignore>
            {% for tag in tags %}
            <a class="chip" href="/tags/{{ tag | ghSlug }}/"><span class="chip__hash">#</span>{{ tag }}</a>
            {% endfor %}
        </div>
        {% endif %}
    </header>

    {% capture tocHtml %}{{ content | tocList }}{% endcapture %}
    <div class="post-body{% if tocHtml == '' %} no-toc{% endif %}">
        <div class="prose">
            {{ content }}
        </div>
        {% if tocHtml != '' %}
        <aside class="post-toc" aria-label="Table of contents" data-pagefind-ignore>
            <nav class="toc panel panel--flat">
                <p class="toc__label"><svg class="ico" aria-hidden="true"><use href="#i-list"></use></svg>Contents</p>
                <ol class="toc__list" id="toc-list">
                    {{ tocHtml }}
                </ol>
            </nav>
        </aside>
        {% endif %}
    </div>

    <p class="visually-hidden" id="copy-status" role="status" aria-live="polite" data-pagefind-ignore></p>

    <footer class="post-footer" data-pagefind-ignore>
        {% assign newerPost = collections.posts | getPreviousCollectionItem %}
        {% assign olderPost = collections.posts | getNextCollectionItem %}
        {% if newerPost or olderPost %}
        <nav class="post-nav" aria-label="Adjacent posts">
            {% if newerPost %}
            <a class="post-nav__card" href="{{ newerPost.url }}">
                <span class="post-nav__label"><svg class="ico" aria-hidden="true"><use href="#i-arrow-left"></use></svg>Newer</span>
                <span class="post-nav__title">{{ newerPost.data.title }}</span>
            </a>
            {% else %}
            <a class="post-nav__card post-nav__card--empty" href="/">
                <span class="post-nav__label"><svg class="ico" aria-hidden="true"><use href="#i-arrow-left"></use></svg>Index</span>
                <span class="post-nav__title">All posts</span>
            </a>
            {% endif %}
            {% if olderPost %}
            <a class="post-nav__card post-nav--next" href="{{ olderPost.url }}">
                <span class="post-nav__label">Older<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></span>
                <span class="post-nav__title">{{ olderPost.data.title }}</span>
            </a>
            {% else %}
            <a class="post-nav__card post-nav__card--empty" href="/">
                <span class="post-nav__label">Index<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></span>
                <span class="post-nav__title">All posts</span>
            </a>
            {% endif %}
        </nav>
        {% endif %}
    </footer>
</article>

<section class="comments" id="comments" data-pagefind-ignore>
    <header class="sec-head">
        <span class="sec-head__no" aria-hidden="true">02</span>
        <h2 class="sec-head__title">Comments<span class="sec-head__dot">.</span></h2>
        <span class="sec-head__rule" aria-hidden="true"></span>
        <div class="sec-head__aside">
            <span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-comment"></use></svg>via GitHub</span>
        </div>
    </header>
    <div class="panel panel--flat" style="padding: 16px">
        <div id="giscus-container"></div>
    </div>
    <script>
        (function () {
            var container = document.getElementById("giscus-container");
            if (!container) return;
            var isDark = document.documentElement.getAttribute("data-theme") === "dark";
            var s = document.createElement("script");
            var attrs = {
                "src": "https://giscus.app/client.js",
                "data-repo": "{{ site.giscus.repo }}",
                "data-repo-id": "{{ site.giscus.repo_id }}",
                "data-category": "{{ site.giscus.category }}",
                "data-category-id": "{{ site.giscus.category_id }}",
                "data-mapping": "{{ site.giscus.mapping }}",
                "data-strict": "{{ site.giscus.strict }}",
                "data-reactions-enabled": "{{ site.giscus.reactions_enabled }}",
                "data-emit-metadata": "{{ site.giscus.emit_metadata }}",
                "data-input-position": "{{ site.giscus.input_position }}",
                "data-theme": isDark ? "noborder_dark" : "noborder_light",
                "data-lang": "{{ site.giscus.lang }}",
                "data-loading": "{{ site.giscus.loading }}",
                "crossorigin": "anonymous"
            };
            for (var key in attrs) s.setAttribute(key, attrs[key]);
            s.async = true;
            container.appendChild(s);
        })();
    </script>
</section>

<dialog class="lightbox" id="lightbox" aria-label="Image preview">
    <div class="dialog__head">
        <span><svg class="ico" aria-hidden="true"><use href="#i-image"></use></svg>Image preview</span>
        <div class="lightbox__nav">
            <button class="lightbox__step" type="button" data-lightbox-prev aria-label="Previous image">
                <svg class="ico" aria-hidden="true"><use href="#i-chev-left"></use></svg>
            </button>
            <span class="lightbox__counter" id="lightbox-counter" aria-hidden="true">1 / 1</span>
            <button class="lightbox__step" type="button" data-lightbox-next aria-label="Next image">
                <svg class="ico" aria-hidden="true"><use href="#i-chev-right"></use></svg>
            </button>
        </div>
        <button class="dialog__close" type="button" data-dialog-close aria-label="Close image preview">&times;</button>
    </div>
    <div class="dialog__body">
        <img id="lightbox-img" alt="">
        <p class="lightbox__caption" id="lightbox-caption"></p>
    </div>
</dialog>