---
layout: base.liquid
title: Search
permalink: /search/
eleventyExcludeFromCollections: true
headExtra: '<link href="/pagefind/pagefind-ui.css" rel="stylesheet">'
---
<div class="search-page">
    <header class="page-head">
        <p class="kicker"><span class="led led--blink" aria-hidden="true"></span>Terminal &middot; full-text index</p>
        <h1 class="page-head__title">Search<span style="color: var(--accent)">.</span></h1>
        <p class="page-head__sub">Every post on this blog, indexed at build time by Pagefind. Nothing leaves your browser.</p>
    </header>

    <section class="sec">
        <div class="panel search-panel">
            <p class="search-panel__head"><svg class="ico" aria-hidden="true"><use href="#i-search"></use></svg>grep -r ./posts</p>
            <div id="search" class="pagefind-box"></div>
            <p class="search-hint">Tip: press <kbd>/</kbd> anywhere to open search. Quotes group phrases: <kbd>"Gradle 镜像"</kbd>.</p>
        </div>
    </section>

    <script src="/pagefind/pagefind-ui.js"></script>
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            if (typeof PagefindUI === "undefined") {
                document.getElementById("search").innerHTML =
                    '<p class="search-unavailable">Search index not available in this build. Run <code>npm run build</code> to generate it.</p>';
                return;
            }
            new PagefindUI({
                element: "#search",
                showSubResults: true,
                showImages: false,
                autofocus: true,
                translations: { placeholder: "Search posts…" }
            });
        });
    </script>
</div>
