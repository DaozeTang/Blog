---
layout: base.liquid
title: Search
permalink: /search/
eleventyExcludeFromCollections: true
headExtra: '<link href="/pagefind/pagefind-ui.css" rel="stylesheet">'
---
<div class="search-page" data-search-page>
    <header class="page-head page-head--split">
        <div class="page-head__main">
            <p class="kicker"><span class="led led--blink" aria-hidden="true"></span>Terminal &middot; full-text index</p>
            <h1 class="page-head__title">Search<span style="color: var(--accent)">.</span></h1>
            <p class="page-head__sub">Every post on this blog, indexed at build time by Pagefind. Nothing leaves your browser.</p>
            <ul class="page-head__meta">
                <li><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-search"></use></svg>{{ collections.posts.size }} posts indexed</span></li>
                <li><a class="chip" href="/archive/"><svg class="ico" aria-hidden="true"><use href="#i-archive"></use></svg>Browse the archive</a></li>
            </ul>
        </div>

        <aside class="page-head__aside" aria-label="Search index at a glance">
            <div class="stamp">
                <p class="stamp__head"><span class="led led--blink" aria-hidden="true"></span>Index<span class="stamp__tag">local</span></p>
                <p class="stamp__value">{{ collections.posts.size }}<span class="stamp__unit">posts</span></p>
                <dl class="stamp__rows">
                    <div><dt>Tags</dt><dd>{{ collections.tagList.size }}</dd></div>
                    <div><dt>Categories</dt><dd>{{ collections.categories.size }}</dd></div>
                </dl>
            </div>
        </aside>
    </header>

    <div class="split search-split">
        <div>
            <section class="sec" aria-labelledby="search-title">
                <header class="sec-head">
                    <span class="sec-head__no" aria-hidden="true">01</span>
                    <h2 class="sec-head__title" id="search-title">Query<span class="sec-head__dot">.</span></h2>
                    <span class="sec-head__rule" aria-hidden="true"></span>
                    <div class="sec-head__aside">
                        <span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-terminal"></use></svg>Pagefind</span>
                    </div>
                </header>
                <div class="panel search-panel">
                    <p class="search-panel__head"><svg class="ico" aria-hidden="true"><use href="#i-search"></use></svg>grep -r ./posts</p>
                    <div id="search" class="pagefind-box"></div>
                    <p class="search-hint">Tip: press <kbd>/</kbd> anywhere to open search. Quotes group phrases: <kbd>"Gradle 镜像"</kbd>.</p>
                </div>
            </section>

            <section class="sec search-start" aria-labelledby="start-title">
                <header class="sec-head">
                    <span class="sec-head__no" aria-hidden="true">02</span>
                    <h2 class="sec-head__title" id="start-title">Start here<span class="sec-head__dot">.</span></h2>
                    <span class="sec-head__rule" aria-hidden="true"></span>
                    <div class="sec-head__aside">
                        <a class="chip" href="/archive/">Archive<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
                    </div>
                </header>

                <ol class="start-list">
                    {% for post in collections.posts limit: 5 %}
                    <li>
                        <a href="{{ post.url }}">
                            <time datetime="{{ post.data.published | isoDate }}">{{ post.data.published | date: "%m-%d" }}</time>
                            <span>{{ post.data.title }}</span>
                            <svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
                        </a>
                    </li>
                    {% endfor %}
                </ol>
            </section>
        </div>

        <aside class="rail" aria-label="Search help">
            <div class="rail__panel">
                <p class="rail__label">Quick tags</p>
                <div class="tag-cloud tag-cloud--rail">
                    {% for term in collections.tagList limit: 8 %}
                    <a class="chip" href="/tags/{{ term.slug }}/" data-search-query="{{ term.name }}"><span class="chip__hash">#</span>{{ term.name }}</a>
                    {% endfor %}
                </div>
            </div>

            <div class="rail__panel">
                <p class="rail__label">How it works</p>
                <ul class="key">
                    <li><span class="led" aria-hidden="true"></span><span>Index built at publish time</span></li>
                    <li><span class="led led--gold" aria-hidden="true"></span><span>Queries run in your browser</span></li>
                    <li><span class="led led--coral" aria-hidden="true"></span><span>No account, no tracking</span></li>
                </ul>
            </div>
        </aside>
    </div>

    <script src="/pagefind/pagefind-ui.js"></script>
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            if (typeof PagefindUI === "undefined") {
                document.getElementById("search").innerHTML =
                    '<p class="search-unavailable">Search index not available in this build. Run <code>npm run build</code> to generate it.</p>';
                return;
            }
            new PagefindUI({
                element: "#search",
                showSubResults: true,
                showImages: false,
                autofocus: true,
                translations: { placeholder: "Search posts…" }
            });
            var input = document.querySelector("#search input");
            if (input) input.setAttribute("aria-label", "Search posts");
        });
    </script>
</div>