---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in collections.sitePages %}
  <url>
    <loc>{{ page.url | encodeUri | prepend: site.url }}</loc>
    {% if page.lastmod %}<lastmod>{{ page.lastmod | isoDate }}</lastmod>{% endif %}
  </url>
{% endfor %}
</urlset>
