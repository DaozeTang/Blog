---
layout: base.liquid
navTitle: Archive
pagination:
  data: collections.categories
  size: 1
  alias: term
permalink: "/categories/{{ term.slug }}/"
eleventyComputed:
  title: "{{ term.name }}"
eleventyExcludeFromCollections: true
---

{% assign firstYear = term.items.first.data.published | date: "%Y" %}
{% assign lastYear = term.items.last.data.published | date: "%Y" %}

<header class="page-head page-head--split">
    <div class="page-head__main">
        <h1 class="page-head__title">{{ term.name }}<span style="color: var(--accent)">.</span></h1>
        <p class="page-head__sub">Every post filed in this category, newest first.</p>
        <ul class="page-head__meta">
            <li><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-file"></use></svg>{{ term.items.size }} post{% if term.items.size > 1 %}s{% endif %}</span></li>
            <li><a class="chip" href="/categories/">All categories<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a></li>
            <li><a class="chip" href="/archive/">Archive<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a></li>
        </ul>
    </div>

    <aside class="page-head__aside" aria-label="Category summary">
        <div class="stamp">
            <p class="stamp__head"><span class="led" aria-hidden="true"></span>Drawer<span class="stamp__tag">{{ collections.categories.size }} total</span></p>
            <p class="stamp__value">{{ term.items.size }}<span class="stamp__unit">posts</span></p>
            <dl class="stamp__rows">
                <div><dt>Span</dt><dd>{% if firstYear == lastYear %}{{ firstYear }}{% else %}{{ lastYear }}&ndash;{{ firstYear }}{% endif %}</dd></div>
                <div><dt>Category</dt><dd>{{ term.name }}</dd></div>
            </dl>
        </div>
    </aside>
</header>

<section class="sec post-feed" aria-labelledby="posts-title">
    <h2 class="visually-hidden" id="posts-title">Posts filed under {{ term.name }}</h2>
    {% assign posts = term.items %}
    {% include "post-list" %}
</section>