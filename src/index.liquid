---
layout: base.liquid
navTitle: Posts
showScene: true
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/{{ pagination.pageNumber | plus: 1 }}/{% endif %}"
eleventyExcludeFromCollections: true
---

{% if pagination.pageNumber == 0 %}
<section class="cover">
    <div class="cover__main">
        <h1 class="cover__title" aria-label="Field notes.">
            <span class="cover__word">Field</span>
            <span class="cover__word">Notes<span class="cover__dot">.</span></span>
        </h1>
        <p class="cover__lede">Technical notes on deep learning, computer vision, Linux ops, and the occasional
            rabbit hole &mdash; written down so I only have to debug things once.</p>
        <ul class="cover__meta" aria-label="Blog at a glance">
            <li><a class="cover__tag" href="/archive/"><span class="cover__tag-k">Posts</span><span class="cover__tag-v">{{ collections.posts.size }}</span></a></li>
            <li><a class="cover__tag" href="/archive/#categories"><span class="cover__tag-k">Categories</span><span class="cover__tag-v">{{ collections.categories.size }}</span></a></li>
            <li><a class="cover__tag" href="/archive/#tags"><span class="cover__tag-k">Tags</span><span class="cover__tag-v">{{ collections.tagList.size }}</span></a></li>
            <li><a class="cover__tag cover__tag--feed" href="/rss.xml"><span class="cover__tag-k">Feed</span><span class="cover__tag-v">RSS</span></a></li>
        </ul>
        <div class="cover__console">
            <a class="cover__search" href="/search/" data-open-search aria-label="Search the archive, shortcut slash">
                <span class="cover__search-prompt" aria-hidden="true">&gt;</span>
                <span class="cover__search-label">Search the archive</span>
                <span class="cover__search-hint" aria-hidden="true">local index</span>
                <kbd aria-hidden="true">/</kbd>
                <svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
            </a>
            <p class="cover__console-note"><span class="led" aria-hidden="true"></span>Full-text index &middot; runs in your browser</p>
        </div>
    </div>

    <aside class="cover__side" aria-label="Field station plate">
        <div class="plate js-plate cover__plate">
            <canvas class="plate__canvas" data-scene="station" role="img" aria-label="False-colour aerial view of a field station at night: a lab building with lit skylights, a dish antenna, a solar array and a cat on the gravel"></canvas>
            <span class="plate__frame" aria-hidden="true"></span>
            <div class="plate__bar" aria-hidden="true">
                <span class="plate__rec"><span class="led"></span>Live</span>
                <span class="plate__seg">station 01 &middot; night</span>
                <span class="plate__seg">RGB &middot; 8 fps</span>
                <span class="plate__seg plate__seg--right" data-readout></span>
            </div>
            <div class="plate__foot" aria-hidden="true">
                <span class="plate__scale">0 &mdash; 20 m</span>
                <span>frame 0001</span>
                <span class="plate__north">N &uarr;</span>
            </div>
        </div>
        <p class="px-caption cover__fig">fig.01 — field station 01 · object detection, live</p>
    </aside>
</section>
{% endif %}

{% if pagination.pageNumber > 0 %}
<h1 class="visually-hidden">Blog &mdash; page {{ pagination.pageNumber | plus: 1 }}</h1>
{% endif %}

<div class="split">
    <section class="sec" aria-labelledby="feed-title">
        <header class="sec-head">
            <span class="sec-head__no" aria-hidden="true">01</span>
            <h2 class="sec-head__title" id="feed-title">{% if pagination.pageNumber == 0 %}Latest posts{% else %}More posts{% endif %}<span class="sec-head__dot">.</span></h2>
            <span class="sec-head__rule" aria-hidden="true"></span>
            <div class="sec-head__aside">
                <a class="chip" href="/archive/">Archive<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
            </div>
        </header>

        {% include "post-list" %}
        {% include "pagination" %}
    </section>

    <aside class="rail" aria-label="Browse the blog">
        <div class="panel rail__panel">
            <p class="rail__label">Categories</p>
            <ul class="rail__list">
                {% for term in collections.categories %}
                <li><a class="rail__link" href="/categories/{{ term.slug }}/"><span>{{ term.name }}</span><span class="rail__count">{{ term.items.size }}</span></a></li>
                {% endfor %}
            </ul>
        </div>

        <div class="panel rail__panel">
            <p class="rail__label">Top tags</p>
            <div class="tag-cloud">
                {% for term in collections.tagList limit: 12 %}
                <a class="chip" href="/tags/{{ term.slug }}/"><span class="chip__hash">#</span>{{ term.name }}</a>
                {% endfor %}
                <a class="chip chip--soft" href="/archive/#tags">all tags</a>
            </div>
        </div>

        <div class="panel rail__panel">
            <p class="rail__label">Subscribe</p>
            <div class="stack stack--tight">
                <a class="btn btn--sm btn--accent" href="/rss.xml"><svg class="ico" aria-hidden="true"><use href="#i-rss"></use></svg>RSS feed</a>
                <a class="btn btn--sm" href="/sitemap.xml"><svg class="ico" aria-hidden="true"><use href="#i-grid"></use></svg>Sitemap</a>
                <a class="btn btn--sm" href="/tools/"><svg class="ico" aria-hidden="true"><use href="#i-floppy"></use></svg>Tools</a>
            </div>
        </div>
    </aside>
</div>
