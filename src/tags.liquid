---
layout: base.liquid
navTitle: Archive
pagination:
  data: collections.tagList
  size: 1
  alias: term
permalink: "/tags/{{ term.slug }}/"
eleventyComputed:
  title: "#{{ term.name }}"
eleventyExcludeFromCollections: true
---

<header class="page-head">
    <p class="kicker"><span class="led" aria-hidden="true"></span>Tag</p>
    <h1 class="page-head__title"><span style="color: var(--accent)">#</span>{{ term.name }}<span style="color: var(--accent)">.</span></h1>
    <ul class="page-head__meta">
        <li><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-file"></use></svg>{{ term.items.size }} post{% if term.items.size > 1 %}s{% endif %}</span></li>
        <li><a class="chip" href="/archive/#tags">All tags<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a></li>
    </ul>
</header>

<section class="sec post-feed">
    {% assign posts = term.items %}
    {% include "post-list" %}
</section>
